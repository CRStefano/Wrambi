{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wrambi",
  "version": "0.2.0",
  "identifier": "it.wrambi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wrambi",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 440,
        "center": true,
        "decorations": true,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#FCFCFB",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Focused writing, a document library and notes linked to the text",
    "longDescription": "Wrambi brings together a distraction-free editor, a document library with reading states, notes anchored to the text, citations from Zotero, a PDF editor that keeps the layout and an encrypted vault. It works offline, without an account. Interface in Italian, English and French.",
    "copyright": "© 2026 Stefano Coelati Rama",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wrambi"
        ],
        "name": "Wrambi vault",
        "description": "Encrypted Wrambi vault",
        "role": "Viewer",
        "mimeType": "application/x-wrambi-vault"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "editors"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
